{
  "name": "ornl-orgchart-studio",
  "productName": "ORNL OrgChart Studio",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Local desktop prototype for governed organizational chart data, layout, review, backup, and export.",
  "author": "UT-Battelle LLC",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "desktop": "node scripts/start-electron.mjs",
    "desktop:smoke": "node scripts/start-electron.mjs --smoke",
    "test:desktop": "npm run build && npm run desktop:smoke",
    "prepare:icons": "node scripts/generate-app-icons.mjs",
    "package:mac": "npm run build && npm run prepare:icons && node scripts/package-electron.mjs mac",
    "package:windows": "npm run build && npm run prepare:icons && node scripts/package-electron.mjs windows",
    "verify:package": "node scripts/verify-packaged-app.mjs",
    "validate:release": "node scripts/validate-release-metadata.mjs",
    "mcp:start": "node mcp/server.mjs",
    "mcp:configure": "node scripts/configure-orgchart-mcp.mjs install",
    "mcp:remove": "node scripts/configure-orgchart-mcp.mjs remove",
    "security:scan": "node scripts/check-no-chart-data.mjs --tracked",
    "pretest": "npm run security:scan",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --import tsx --test tests/*.test.*",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern out --ignore-pattern releases --ignore-pattern tmp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-squirrel-startup": "^1.0.1",
    "wrangler": "4.118.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260731.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@xyflow/react": "^12.11.2",
    "electron": "43.2.0",
    "elkjs": "^0.11.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "fflate": "0.8.3",
    "next": "16.2.12",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "type": "module"
}
