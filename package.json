{
  "name": "ornl-orgchart-studio",
  "productName": "ORNL OrgChart Studio",
  "version": "0.4.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "OrgChart Studio web and desktop editor with portable local libraries, review, history, and export.",
  "author": "UT-Battelle LLC",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build && npm run web:build",
    "start": "node scripts/run-vinext.mjs start",
    "desktop": "node scripts/start-electron.mjs",
    "desktop:smoke": "node scripts/start-electron.mjs --smoke",
    "test:desktop": "npm run build && npm run desktop:smoke",
    "prepare:icons": "node scripts/generate-app-icons.mjs",
    "package:mac": "npm run build && npm run prepare:icons && node scripts/package-electron.mjs mac",
    "package:windows": "npm run build && npm run prepare:icons && node scripts/package-electron.mjs windows",
    "verify:package": "node scripts/verify-packaged-app.mjs",
    "validate:release": "node scripts/validate-release-metadata.mjs",
    "mcp:start": "node mcp/server.mjs",
    "mcp:configure": "node scripts/configure-orgchart-mcp.mjs install",
    "mcp:remove": "node scripts/configure-orgchart-mcp.mjs remove",
    "security:scan": "node scripts/check-no-chart-data.mjs --tracked",
    "pretest": "npm run security:scan",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --import tsx --test tests/*.test.*",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern out --ignore-pattern releases --ignore-pattern tmp --ignore-pattern public",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts --host 127.0.0.1 --port 4188",
    "web:verify": "node scripts/verify-web-artifact.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "electron-squirrel-startup": "^1.0.1",
    "sql.js": "1.17.0",
    "wrangler": "4.164.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@cloudflare/workers-types": "5.20261118.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "1.16.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "@xyflow/react": "^12.11.2",
    "electron": "43.8.11",
    "elkjs": "^0.11.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "fflate": "0.8.3",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "1.4.6",
    "vite": "8.3.8"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "undici": "7.30.2",
    "pptxgenjs": {
      "image-size": "2.1.0"
    },
    "satori": {
      "fflate": "0.8.3"
    }
  },
  "type": "module"
}
