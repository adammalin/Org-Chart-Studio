{
  "name": "ornl-orgchart-studio",
  "productName": "ORNL OrgChart Studio",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Local desktop prototype for governed organizational chart data, layout, review, backup, and export.",
  "author": "UT-Battelle LLC",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop": "node scripts/start-electron.mjs",
    "desktop:smoke": "ORGCHART_ELECTRON_SMOKE=1 node scripts/start-electron.mjs",
    "test:desktop": "npm run build && npm run desktop:smoke",
    "security:scan": "node scripts/check-no-chart-data.mjs --tracked",
    "pretest": "npm run security:scan",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --import tsx --test tests/*.test.*",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.11.1",
    "fflate": "0.8.3",
    "next": "16.2.12",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260731.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "43.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
